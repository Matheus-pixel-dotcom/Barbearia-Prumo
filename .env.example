# =====================================================================
#  Style Relo Barber — configuração da IA (Nano Banana / Gemini Image)
# =====================================================================
#
#  COMO LIGAR A IA (2 minutos):
#
#  1. Abra https://aistudio.google.com/apikey e entre com sua conta Google.
#  2. Clique em "Create API key" (Criar chave de API) e copie a chave.
#     Ela começa com "AIza...".
#  3. Copie este arquivo para ".env" (no terminal: cp .env.example .env)
#     e cole a chave abaixo.
#  4. Rode: npm run serve
#     O console vai mostrar "IA: Nano Banana ATIVO".
#
#  IMPORTANTE: o arquivo .env NÃO sobe para o GitHub (está no .gitignore).
#  Nunca cole a chave direto no código nem no HTML — ela ficaria pública.
#
#  SEM CHAVE nada quebra: o site continua igual, só que o simulador mostra
#  o aviso de "modo demonstrativo" em vez de gerar a foto.
# =====================================================================

# Obrigatório para a IA funcionar.
GEMINI_API_KEY=cole_sua_chave_aqui

# ---------------------------------------------------------------------
# Opcionais — os padrões já funcionam bem, só mexa se precisar.
# ---------------------------------------------------------------------

# Força um modelo específico de imagem. Vazio = tenta os mais novos
# automaticamente (gemini-3.1-flash-image-preview → gemini-2.5-flash-image...).
#NANO_BANANA_MODEL=gemini-3.1-flash-image-preview

# Modelo de texto usado pela Relo IA (chat) e pela análise de rosto.
#GEMINI_TEXT_MODEL=gemini-2.5-flash

# Quantas gerações cada visitante pode pedir por hora (protege seu crédito).
#IA_LIMITE_POR_HORA=30

# Porta e host do servidor (padrão: 8000 / 0.0.0.0).
#PORT=8000
#HOST=0.0.0.0
