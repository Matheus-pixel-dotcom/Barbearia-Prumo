# Style Relo Barber — variáveis de ambiente (exemplo)
#
# Copie este arquivo como ".env" e ajuste os valores.
# O arquivo .env NÃO vai para o GitHub (está no .gitignore) — ele serve para
# guardar segredos fora do código. No Render/Railway, cadastre as mesmas
# variáveis no painel do serviço.

# Porta e endereço do servidor (o host normalmente define a porta sozinho)
PORT=8000
HOST=0.0.0.0

# Pasta do banco em arquivo (data/db.json por padrão)
# RELO_DATA_DIR=./data

# ---------------------------------------------------------------------
# Banco de dados durável e compartilhado (opcional, recomendado em nuvem)
# Rode supabase/relo_db.sql no painel do Supabase antes de usar.
# ---------------------------------------------------------------------
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-chave-service_role
# RELO_SUPABASE_TABLE=relo_db
